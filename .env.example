# Скопируйте в .env (файл .env в git не попадает).
# ВАЖНО: не публикуйте секретный ключ в чатах и в репозитории. Если ключ засветился — перевыпустите в ЮKassa: Интеграция → Секретный ключ.

YOOKASSA_SHOP_ID=1329080
YOOKASSA_SECRET_KEY=ваш_секретный_ключ_из_личного_кабинета

# Прокси /api/yookassa/* работает только при `npm run dev`.
# Прод: Supabase Edge Functions + секреты в Dashboard — см. docs/supabase-yookassa-setup.md

# --- Чат ИИ (OpenRouter), только dev-прокси /api/ai/chat; ключ не во фронт ---
# Файл .env должен лежать в КОРНЕ проекта (рядом с vite.config.js), затем перезапустите `npm run dev`.
# Ключ: https://openrouter.ai/keys — если светили в чате, перевыпустите.
OPENROUTER_API_KEY=your_openrouter_api_key
# Необязательно, по умолчанию openai/gpt-oss-120b:free
# OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Прод: URL backend endpoint для чата (например, Firebase Function HTTPS URL)
# VITE_SILVA_AI_CHAT_URL=https://REGION-PROJECT.cloudfunctions.net/silvaOpenrouterChat
# Опционально: bearer-токен для удаленного endpoint чата
# VITE_SILVA_AI_CHAT_BEARER=your_chat_bearer_token

# Firebase Web SDK config для React-части (если понадобится)
# VITE_FIREBASE_API_KEY=...
# VITE_FIREBASE_AUTH_DOMAIN=...
# VITE_FIREBASE_PROJECT_ID=...
# VITE_FIREBASE_STORAGE_BUCKET=...
# VITE_FIREBASE_MESSAGING_SENDER_ID=...
# VITE_FIREBASE_APP_ID=...

# --- Yandex Object Storage (dev proxy /api/storage/upload) ---
# YC_STORAGE_ENDPOINT=https://storage.yandexcloud.net
# YC_STORAGE_REGION=ru-central1
# YC_STORAGE_BUCKET=silva
# YC_STORAGE_ACCESS_KEY_ID=...
# YC_STORAGE_SECRET_ACCESS_KEY=...

# Системный промпт чата (без секретов): supabase/functions/silva-openrouter-chat/silva-ai-system-prompt.txt
